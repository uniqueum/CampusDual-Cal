    "format": "prettier --write public/* server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.2.5"
  },
