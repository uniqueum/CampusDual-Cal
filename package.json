{
  "name": "campusdual-cal-applet",
  "version": "1.0.0",
  "description": "Local campus synchronization applet for Berufsakademie Dresden",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "sync": "cross-env PYTHONPATH=. python main.py sync-only",
